<!DOCTYPE html>
<html lang="en" data-theme="dim">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Projects – Climate Solutions</title>
  <link rel="stylesheet" href="/css/main.css?v=<%= Date.now() %>">
</head>
<body class="bg-base-100">

  <!-- Navbar -->
  <%- include('partials/navbar', { page: '/solutions/projects' }) %>

  <!-- Hero header -->
  <section class="hero bg-base-200 rounded-2xl my-8">
    <div class="hero-content text-center">
      <div>
        <h1 class="text-4xl font-bold mb-2">Projects</h1>
        <p class="mb-4 text-lg">
          Browse all projects or filter by sector to explore sustainable innovations.
        </p>
        <div class="join">
          <a class="btn join-item" href="/solutions/projects?sector=energy">Energy</a>
          <a class="btn join-item" href="/solutions/projects?sector=industry">Industry</a>
          <a class="btn join-item" href="/solutions/projects?sector=transportation">Transportation</a>
        </div>
        <% if (sector) { %>
          <div class="mt-4">
            <span class="badge badge-primary p-3">Filter: <%= sector %></span>
            <a href="/solutions/projects" class="btn btn-ghost btn-sm ml-2">Clear</a>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Projects table -->
  <div class="container mx-auto px-4 pb-12 overflow-x-auto">
    <table class="table table-zebra w-full">
      <thead>
        <tr>
          <th class="text-lg">Title</th>
          <th class="text-lg">Sector</th>
          <th class="text-lg">Summary</th>
          <th class="text-lg">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (projects && projects.length > 0) { %>
          <% projects.forEach(p => { %>
            <tr>
              <td class="font-semibold"><%= p.title %></td>
              <td>
                <a class="btn btn-sm btn-outline"
                   href="/solutions/projects?sector=<%= encodeURIComponent(p.sector) %>">
                   <%= p.sector %>
                </a>
              </td>
              <td><%= p.summary_short %></td>
              <td>
                <a class="btn btn-sm btn-primary"
                   href="/solutions/projects/<%= p.id %>">Details</a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" class="text-center py-6">
              No projects found<% if (sector) { %> for "<%= sector %>"<% } %>.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

</body>
</html>
