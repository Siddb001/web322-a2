<!DOCTYPE html>
<html lang="en" data-theme="dim">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Climate Solutions – Home</title>
  <link rel="stylesheet" href="/css/main.css?v=<%= Date.now() %>">
</head>
<body class="bg-base-100">

  <!-- Navbar -->
  <div class="navbar bg-base-100">
    <div class="flex-1">
      <a href="/" class="btn btn-ghost normal-case text-xl">Climate Solutions</a>
    </div>
    <div class="flex-none">
      <ul class="menu menu-horizontal px-1">
        <li><a href="/about">About</a></li>
        <li>
          <details>
            <summary>Sector</summary>
            <ul class="p-2 bg-base-100">
              <li><a href="/solutions/projects?sector=energy">Energy</a></li>
              <li><a href="/solutions/projects?sector=industry">Industry</a></li>
              <li><a href="/solutions/projects?sector=transportation">Transportation</a></li>
            </ul>
          </details>
        </li>
      </ul>
    </div>
  </div>

  <!-- Hero Section -->
  <div class="hero min-h-[60vh] bg-base-200">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-5xl font-bold">Explore Our Projects</h1>
        <p class="py-6">Discover innovative climate solutions that make a difference.</p>
        <a href="/solutions/projects" class="btn btn-primary">View Projects</a>
      </div>
    </div>
  </div>

  <!-- Dynamic Project Cards -->
  <div class="container mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 my-8 px-4">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach(p => { %>
        <div class="card bg-base-100 shadow-xl">
          <figure>
            <img 
              src="<%= p.image || p.feature_img_url || '/images/project-1.jpg' %>" 
              alt="<%= p.title %>" 
              class="w-full h-48 object-cover" 
              onerror="this.src='https://placehold.co/400x200?text=No+Image';" 
            />
          </figure>
          <div class="card-body">
            <h2 class="card-title"><%= p.title %></h2>
            <p><%= p.summary_short %></p>
            <div class="card-actions justify-end">
              <a href="/solutions/projects/<%= p.id %>" class="btn btn-primary">Details</a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="text-center w-full">No projects available.</p>
    <% } %>
  </div>

</body>
</html>
