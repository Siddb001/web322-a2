<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Climate Solutions</title>
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body class="bg-base-100">

  <!-- Navbar -->
  <div class="navbar bg-base-100">
    <div class="flex-1">
      <a href="/" class="btn btn-ghost normal-case text-xl">Climate Solutions</a>
    </div>
    <div class="flex-none">
      <ul class="menu menu-horizontal px-1">
        <li><a href="/about">About</a></li>
        <li>
          <details>
            <summary>Sector</summary>
            <ul class="p-2 bg-base-100">
              <li><a href="/solutions/projects?sector=energy">Energy</a></li>
              <li><a href="/solutions/projects?sector=industry">Industry</a></li>
              <li><a href="/solutions/projects?sector=transportation">Transportation</a></li>
            </ul>
          </details>
        </li>
      </ul>
    </div>
  </div>

  <!-- Hero Section -->
  <div class="hero min-h-[60vh] bg-base-200">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-5xl font-bold">Explore Our Projects</h1>
        <p class="py-6">Discover innovative climate solutions that make a difference.</p>
        <a href="/solutions/projects" class="btn btn-primary">View Projects</a>
      </div>
    </div>
  </div>

  <!-- Cards Grid -->
  <div class="container mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 my-8 px-4">
    <div class="card bg-base-100 shadow-xl">
      <figure><img src="https://placehold.co/400x200" alt="Project 1" /></figure>
      <div class="card-body">
        <h2 class="card-title">Project 1</h2>
        <p>Short summary about project 1.</p>
        <div class="card-actions justify-end">
          <a href="/solutions/projects/1" class="btn btn-primary">Details</a>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <figure><img src="https://placehold.co/400x200" alt="Project 2" /></figure>
      <div class="card-body">
        <h2 class="card-title">Project 2</h2>
        <p>Short summary about project 2.</p>
        <div class="card-actions justify-end">
          <a href="/solutions/projects/2" class="btn btn-primary">Details</a>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <figure><img src="https://placehold.co/400x200" alt="Project 3" /></figure>
      <div class="card-body">
        <h2 class="card-title">Project 3</h2>
        <p>Short summary about project 3.</p>
        <div class="card-actions justify-end">
          <a href="/solutions/projects/3" class="btn btn-primary">Details</a>
        </div>
      </div>
    </div>
  </div>

</body>
</html>
